# 复制为 .env 并填入真实值（.env 已被 gitignore 忽略，不会进仓库）
ARK_API_KEY=SCT427162TrYVlNoytB5SnzH0S892jgHpP
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=doubao-seed-1-6-250615
# AI 层：默认 doubao；没配 ARK_API_KEY 时自动用 MockProvider（离线可跑）
