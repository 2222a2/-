# RAG 检索后端：fts（默认，SQLite FTS5）| chromadb（语义向量，需先 pip install chromadb）
RAG_BACKEND=fts
ONLYOFFICE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000
